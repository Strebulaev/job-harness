# Copy to .env and fill in. Never commit .env.
# From @BotFather in Telegram:
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot to see it). Only this user can use the bot.
TELEGRAM_OWNER_ID=
# Encrypts the OpenRouter/SuperJob keys you paste in chat. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose it, stored keys cannot be decrypted (just /connect again).
JH_MASTER_KEY=
